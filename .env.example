# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_gateway

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# JWT Security Configurations
# Generate secure secret: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Langfuse Observability & Tracing (Optional)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Prompt Caching Configurations
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.90
EMBEDDING_PROVIDER=gemini

# Evaluator (LLM-as-a-Judge) Configurations
EVALUATOR_PROVIDER=gemini
EVALUATOR_MODEL=gemini-2.0-flash

# Logging & Payload Storage
STORE_FULL_PAYLOAD=true
